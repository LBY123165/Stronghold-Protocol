# /etc/stronghold/stronghold.env — 卫戍协议：盟约 · 服务器环境变量 (docs/DEPLOY-LINUX.md)
#
# 权限建议：sudo install -m 0640 -o root -g stronghold deploy/stronghold.env.example /etc/stronghold/stronghold.env
# 这个文件里有 ADMIN_SECRET，别让它进 git、别 world-readable。
# 每行 `KEY=值`，不要加引号（systemd 的 EnvironmentFile 会连引号一起当值）。

# ---- 监听 ------------------------------------------------------------------------------------
# 端口（默认 3000）。用反向代理时保持 3000，只让本机访问。
PORT=3000
# 绑定地址。默认 `::` 双栈；只给反代用可以设 127.0.0.1（更安全：外网碰不到它）。
HOST=127.0.0.1
# 反向代理后面拿真实客户端 IP（net.js clientAddress）。`auto` = 只信 loopback/内网来源的转发头。
TRUST_PROXY=auto

# ---- 运维后台 (docs/ADMIN.md) -----------------------------------------------------------------
# 至少 16 位。留空 = 后台整体关闭（没有默认口令，这是刻意的）。
# 两种写法二选一；推荐用文件：进程环境里看不到密钥，`ps eww` 也看不到。
ADMIN_SECRET_FILE=/etc/stronghold/admin.secret
#ADMIN_SECRET=把 openssl rand -hex 32 的输出贴这里

# ---- 玩法与性能 ------------------------------------------------------------------------------
# client = 各玩家浏览器模拟自己的战斗（服务器负载极低，默认）；server = 服务器模拟并推流（老模式，CPU 高）
SP_COMBAT=client
# 服务器复算客户端上报的战斗结果：off / sample（约 1/8 抽查）/ all（全部复算）
SP_VERIFY=off
# 每个房间的 AI 上限；unlimited 或不写 = 只受房间容量限制
#SP_MAX_AI_PER_ROOM=4
# 要求玩家先预缓存素材才准入（弱网/大房间场景有用）：required / optional
#SP_REQUIRE_ASSET_CACHE=optional
# 素材在线限速（Mbps）：总限速 / 单 IP 限速
#SP_ASSET_CACHE_TOTAL_BPS=20000000
#SP_ASSET_CACHE_CLIENT_BPS=2000000
# 运行期可写目录（放公告与 server-settings.json；systemd 单元的 ReadWritePaths 必须包含它）
#SP_SERVER_SETTINGS_DIR=/opt/stronghold/runtime

# ---- 调试 ------------------------------------------------------------------------------------
#DEBUG=1
